<script>
(function () {
  var real = function (v) { return 'R$ ' + Math.round(v).toLocaleString('pt-BR'); };
  var ped = document.getElementById('ccPed'),
      tk  = document.getElementById('ccTk'),
      tx  = document.getElementById('ccTx');
  if (!ped) return;

  function calcular() {
    var p = +ped.value, t = +tk.value, x = +tx.value;
    document.getElementById('ccPedV').textContent = p.toLocaleString('pt-BR');
    document.getElementById('ccTkV').textContent = 'R$ ' + t;
    document.getElementById('ccTxV').textContent = x + '%';

    var comissaoAno = p * t * (x / 100) * 12;
    var mensalidadeAno = 199 * 12;
    document.getElementById('ccMkt').textContent = real(comissaoAno);
    document.getElementById('ccEco').textContent = real(Math.max(0, comissaoAno - mensalidadeAno));

    // O lead chega no WhatsApp com a conta dele já feita.
    document.getElementById('ccCta').href = 'https://wa.me/5515998602332?text=' + encodeURIComponent(
      'Fiz a conta no site do BoraHapp: pago cerca de ' + real(comissaoAno) + ' por ano de comissão ' +
      '(' + p + ' pedidos/mês, ticket R$ ' + t + ', taxa de ' + x + '%). Quero saber mais.');
  }

  [ped, tk, tx].forEach(function (el) { el.addEventListener('input', calcular); });
  calcular();
})();
</script>
