/* BoraHapp — site institucional
   Sem fonte externa e sem framework de propósito: o público abre no 4G do interior,
   e cada requisição a mais é meio segundo de espera antes do primeiro texto aparecer.
   Paleta: laranja (comida, urgência) + verde (dinheiro, economia). O roxo do produto
   fica no painel — aqui ele competia com o preço na hora da decisão. */

:root {
  --papel: #FBF7F3;
  --papel-2: #F4EDE4;
  --branco: #FFFFFF;
  --tinta: #1B1512;
  --tinta-2: #4B4039;
  --fumaca: #7C6F66;
  --linha: #E7DCD0;
  --linha-forte: #D4C4B4;

  --brasa: #D9502B;
  --brasa-esc: #B03D1E;
  --brasa-fraca: #FCEDE7;

  --verde: #176B4F;
  --verde-fraco: #E6F2EC;

  --carvao: #17120F;
  --carvao-2: #241C17;

  --sombra: 0 1px 2px rgba(27,21,18,.06), 0 10px 30px -18px rgba(27,21,18,.35);
  --raio: 14px;
  --largura: 1080px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { transition: none !important; animation: none !important; }
}

body {
  margin: 0;
  background: var(--papel);
  color: var(--tinta);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 17px;              /* piso alto: o leitor tem 45+ e lê no sol */
  line-height: 1.62;
  -webkit-font-smoothing: antialiased;
}

.wrap { max-width: var(--largura); margin: 0 auto; padding: 0 20px; }
.estreito { max-width: 760px; }

a { color: var(--brasa-esc); text-underline-offset: 3px; }
a:hover { color: var(--brasa); }
:focus-visible { outline: 3px solid var(--brasa); outline-offset: 3px; border-radius: 4px; }

img { max-width: 100%; height: auto; }

/* ---------------- tipografia ---------------- */
h1, h2, h3 { line-height: 1.12; letter-spacing: -.022em; margin: 0; text-wrap: balance; }
h1 { font-size: clamp(2.05rem, 6vw, 3.3rem); font-weight: 800; }
h2 { font-size: clamp(1.6rem, 4.2vw, 2.3rem); font-weight: 800; }
h3 { font-size: 1.16rem; font-weight: 700; letter-spacing: -.01em; }
p { margin: 0 0 16px; }
.lead { font-size: clamp(1.06rem, 2.4vw, 1.28rem); color: var(--tinta-2); max-width: 42ch; }
.apoio { color: var(--tinta-2); max-width: 62ch; }
.mini { font-size: 14.5px; color: var(--fumaca); }

.kicker {
  font-size: 12.5px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase;
  color: var(--brasa-esc); margin: 0 0 10px;
}
.kicker.verde { color: var(--verde); }

/* ---------------- cabeçalho ---------------- */
header.topo {
  position: sticky; top: 0; z-index: 50;
  background: rgba(251,247,243,.94);
  border-bottom: 1px solid var(--linha);
}
header.topo .wrap { display: flex; align-items: center; gap: 20px; height: 66px; }
.marca {
  font-weight: 800; font-size: 1.22rem; letter-spacing: -.03em;
  color: var(--tinta); text-decoration: none; white-space: nowrap;
}
.marca span { color: var(--brasa); }
nav.menu { display: flex; gap: 22px; margin-left: auto; }
nav.menu a {
  color: var(--tinta-2); text-decoration: none; font-size: 15.5px; font-weight: 600;
  padding: 6px 0; border-bottom: 2px solid transparent;
}
nav.menu a:hover, nav.menu a[aria-current="page"] { color: var(--tinta); border-bottom-color: var(--brasa); }
.topo-acoes { display: flex; gap: 10px; align-items: center; }

/* ---------------- botões ---------------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 14px 24px; border-radius: 11px; font-size: 16px; font-weight: 700;
  text-decoration: none; border: 2px solid transparent; cursor: pointer;
  min-height: 50px;             /* alvo de toque confortável no celular */
  font-family: inherit; line-height: 1.2; text-align: center;
}
.btn-principal { background: var(--brasa); color: #fff; }
.btn-principal:hover { background: var(--brasa-esc); color: #fff; }
.btn-linha { background: transparent; color: var(--tinta); border-color: var(--linha-forte); }
.btn-linha:hover { border-color: var(--tinta); color: var(--tinta); }
.btn-verde { background: var(--verde); color: #fff; }
.btn-verde:hover { background: #115540; color: #fff; }
.btn-pequeno { padding: 9px 16px; min-height: 40px; font-size: 14.5px; border-radius: 9px; }
.btn-claro { background: #fff; color: var(--tinta); }
.btn-claro:hover { background: var(--papel-2); color: var(--tinta); }
.acoes { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }

/* ---------------- seções ---------------- */
section { padding: 64px 0; }
section.compacta { padding: 44px 0; }
section.clara { background: var(--branco); border-top: 1px solid var(--linha); border-bottom: 1px solid var(--linha); }
section.escura { background: var(--carvao); color: #F5EFE9; }
section.escura h2, section.escura h3 { color: #fff; }
section.escura .apoio, section.escura p { color: #D8CCC2; }
section.escura .kicker { color: #F0A88C; }

.cabeca { max-width: 640px; margin-bottom: 34px; }
.cabeca p { margin-top: 12px; }

/* ---------------- hero ---------------- */
.hero { padding: 62px 0 54px; }
.hero-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: 48px; align-items: center; }
.selo {
  display: inline-flex; align-items: center; gap: 8px; background: var(--verde-fraco);
  color: var(--verde); font-weight: 700; font-size: 14px; padding: 7px 14px;
  border-radius: 999px; margin-bottom: 20px;
}
.selo b { font-weight: 800; }
.hero h1 em { font-style: normal; color: var(--brasa); }
.hero-nota { margin-top: 18px; font-size: 15px; color: var(--fumaca); }

/* peça visual do hero: o pedido chegando, que é o momento que o lojista reconhece */
.palco {
  background: var(--branco); border: 1px solid var(--linha); border-radius: 18px;
  padding: 20px; box-shadow: var(--sombra);
}
.palco-topo {
  display: flex; align-items: center; gap: 10px; padding-bottom: 14px;
  border-bottom: 1px solid var(--linha); margin-bottom: 14px;
}
.ponto { width: 9px; height: 9px; border-radius: 50%; background: var(--verde); flex: 0 0 auto; }
.palco-topo b { font-size: 14.5px; }
.palco-topo span { margin-left: auto; font-size: 12.5px; color: var(--fumaca); }
.pedido {
  border: 1px solid var(--linha); border-left: 4px solid var(--brasa);
  border-radius: 10px; padding: 13px 15px; margin-bottom: 10px; background: var(--papel);
}
.pedido.pronto { border-left-color: var(--verde); }
.pedido-cab { display: flex; align-items: baseline; gap: 10px; margin-bottom: 5px; }
.pedido-cab b { font-size: 15px; }
.pedido-cab .canal { font-size: 12px; color: var(--fumaca); margin-left: auto; }
.pedido p { margin: 0; font-size: 14px; color: var(--tinta-2); }
.etiqueta {
  display: inline-block; font-size: 11.5px; font-weight: 700; letter-spacing: .04em;
  text-transform: uppercase; padding: 2px 8px; border-radius: 999px;
  background: var(--brasa-fraca); color: var(--brasa-esc);
}
.etiqueta.ok { background: var(--verde-fraco); color: var(--verde); }

/* ---------------- listas e grades ---------------- */
.grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
.cartao {
  background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio);
  padding: 22px; box-shadow: var(--sombra);
}
.cartao h3 { margin-bottom: 7px; }
.cartao p { margin: 0; color: var(--tinta-2); font-size: 15.5px; }

.passos { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 22px; counter-reset: p; }
.passo { counter-increment: p; }
.passo::before {
  content: counter(p); display: grid; place-items: center; width: 40px; height: 40px;
  border-radius: 50%; background: var(--brasa); color: #fff; font-weight: 800; font-size: 18px;
  margin-bottom: 12px;
}
.passo h3 { margin-bottom: 6px; }
.passo p { color: var(--tinta-2); font-size: 15.5px; margin: 0; }

.dores { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.dores li {
  padding-left: 30px; position: relative; color: var(--tinta-2); max-width: 62ch;
}
.dores li::before {
  content: "×"; position: absolute; left: 6px; top: -1px;
  color: var(--brasa); font-weight: 800; font-size: 20px;
}

.checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
.checks li { padding-left: 28px; position: relative; font-size: 15.5px; }
.checks li::before {
  content: "✓"; position: absolute; left: 4px; color: var(--verde); font-weight: 800;
}

/* ---------------- comparativo ---------------- */
.confronto { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 26px; }
.lado { border-radius: var(--raio); padding: 24px; border: 1px solid var(--linha); background: var(--branco); }
.lado.ruim { border-color: #E9C6BA; background: var(--brasa-fraca); }
.lado.bom { border-color: #B6D9C8; background: var(--verde-fraco); }
.lado h3 { font-size: 1rem; margin-bottom: 10px; }
.valor { font-size: clamp(1.9rem, 5vw, 2.5rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; }
.lado.ruim .valor { color: var(--brasa-esc); }
.lado.bom .valor { color: var(--verde); }
.valor small { display: block; font-size: 14px; font-weight: 600; color: var(--tinta-2); margin-top: 8px; letter-spacing: 0; }

/* ---------------- calculadora ---------------- */
.calc { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-items: center; margin-top: 30px; }
.controle { margin-bottom: 22px; }
.controle label { display: flex; justify-content: space-between; font-size: 15px; font-weight: 600; margin-bottom: 8px; }
.controle b { color: #FFC9AE; font-variant-numeric: tabular-nums; }
input[type=range] {
  width: 100%; height: 30px; -webkit-appearance: none; appearance: none; background: transparent; cursor: pointer;
}
input[type=range]::-webkit-slider-runnable-track { height: 6px; border-radius: 99px; background: #3A2E27; }
input[type=range]::-moz-range-track { height: 6px; border-radius: 99px; background: #3A2E27; }
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%;
  background: var(--brasa); border: 3px solid #fff; margin-top: -10px;
}
input[type=range]::-moz-range-thumb {
  width: 26px; height: 26px; border-radius: 50%; background: var(--brasa); border: 3px solid #fff;
}
.resultado { background: var(--carvao-2); border-radius: var(--raio); padding: 26px; text-align: center; }
.resultado .rot { font-size: 14px; color: #C7B8AC; }
.resultado .grande { font-size: clamp(2rem, 6vw, 2.8rem); font-weight: 800; letter-spacing: -.03em; margin: 6px 0 20px; }
.resultado .perda { color: #FF9B76; }
.resultado .ganho { color: #6FD3A8; }

/* ---------------- preço ---------------- */
.plano {
  background: var(--branco); border: 2px solid var(--brasa); border-radius: 18px;
  padding: 32px; box-shadow: var(--sombra); display: grid; grid-template-columns: 1fr 1fr; gap: 32px;
}
.plano .preco { font-size: clamp(2.6rem, 8vw, 3.6rem); font-weight: 800; letter-spacing: -.035em; line-height: 1; }
.plano .preco span { font-size: 1.05rem; font-weight: 600; color: var(--fumaca); letter-spacing: 0; }
.faixa {
  background: var(--verde-fraco); border: 1px solid #B6D9C8; border-radius: var(--raio);
  padding: 20px 24px; margin-top: 20px;
}
.faixa h3 { color: var(--verde); margin-bottom: 6px; }
.faixa p { margin: 0; color: var(--tinta-2); font-size: 15.5px; }

.addon { background: var(--papel-2); border: 1px dashed var(--linha-forte); border-radius: var(--raio); padding: 26px; margin-top: 20px; }

/* ---------------- roadmap ---------------- */
.trilha { display: grid; gap: 14px; margin-top: 22px; }
.item-trilha {
  display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start;
  background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio); padding: 18px 20px;
}
.item-trilha .marca-estado {
  font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 999px; white-space: nowrap;
}
.estado-agora { background: var(--verde-fraco); color: var(--verde); }
.estado-obra { background: var(--brasa-fraca); color: var(--brasa-esc); }
.item-trilha h3 { font-size: 1.02rem; margin-bottom: 4px; }
.item-trilha p { margin: 0; font-size: 15px; color: var(--tinta-2); }

/* ---------------- faq ---------------- */
.faq { display: grid; gap: 10px; margin-top: 26px; }
.faq details {
  background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio); padding: 4px 20px;
}
.faq summary {
  cursor: pointer; font-weight: 700; padding: 15px 0; list-style: none; font-size: 16.5px;
  display: flex; justify-content: space-between; gap: 14px; align-items: center;
}
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; color: var(--brasa); font-size: 22px; font-weight: 700; }
.faq details[open] summary::after { content: "−"; }
.faq details p { margin: 0 0 16px; color: var(--tinta-2); font-size: 15.5px; max-width: 68ch; }

/* ---------------- confiança ---------------- */
.confianca { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px; margin-top: 24px; }
.confianca div {
  border-left: 3px solid var(--verde); padding-left: 16px;
}
.confianca b { display: block; margin-bottom: 3px; }
.confianca span { font-size: 15px; color: var(--tinta-2); }

/* ---------------- rodapé ---------------- */
footer.rodape { background: var(--carvao); color: #C8BBB1; padding: 46px 0 30px; font-size: 15px; }
footer.rodape a { color: #E8DED6; text-decoration: none; }
footer.rodape a:hover { color: #fff; text-decoration: underline; }
.rodape-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 30px; }
.rodape-grid h4 { color: #fff; font-size: 14px; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 12px; }
.rodape-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.rodape-fim {
  margin-top: 34px; padding-top: 22px; border-top: 1px solid #332821;
  display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13.5px; color: #9A8B80;
}

/* ---------------- barra fixa do celular ---------------- */
.barra-zap { display: none; }
@media (max-width: 860px) {
  .barra-zap {
    display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    background: var(--branco); border-top: 1px solid var(--linha); padding: 10px 16px;
    padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  }
  .barra-zap .btn { width: 100%; }
  body { padding-bottom: 78px; }
}

/* ---------------- responsivo ---------------- */
@media (max-width: 900px) {
  .hero-grid, .calc, .plano, .confronto { grid-template-columns: 1fr; }
  .hero-grid { gap: 34px; }
  .plano { gap: 24px; padding: 26px; }
  .rodape-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 860px) {
  nav.menu { display: none; }
  .topo-acoes .btn-linha { display: none; }
  section { padding: 48px 0; }
}
@media (max-width: 520px) {
  .rodape-grid { grid-template-columns: 1fr; }
  .acoes .btn { width: 100%; }
}
